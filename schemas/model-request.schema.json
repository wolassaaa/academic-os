{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-os.local/schemas/model-request.schema.json",
  "title": "Academic OS reserved model request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "capability", "timezone", "input"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "capability": {"enum": ["date_extraction", "task_classification", "plan_suggestions"]},
    "timezone": {"type": "string", "minLength": 1},
    "input": {"type": "object", "required": ["text"], "additionalProperties": false, "properties": {"text": {"type": "string", "maxLength": 200000}, "source_id": {"type": ["string", "null"]}}},
    "context": {"type": "object"}
  }
}
